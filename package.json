    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:build:android": "npm run build:prod && npx cap sync && npx cap open android",
    "cap:build:ios": "npm run build:prod && npx cap sync && npx cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
