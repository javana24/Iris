PORT=3001

# Proveedor principal y fallback (gemini | deepseek | openai)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openai

# Keys por proveedor (configura al menos una)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# Guardrails de coste/latencia
LLM_TIMEOUT_MS=12000
LLM_MAX_OUTPUT_TOKENS=512

# RAG minimo (dataset local para MVP)
RAG_ENABLED=true
RAG_DATASET_PATH=./data/rag-dataset.json
RAG_TOP_K=3
RAG_MIN_SCORE=0.08
