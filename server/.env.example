# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env

# Proveedor de IA: "ollama" (Spark del instituto) o "gemini" (Google)
AI_PROVIDER=ollama

# --- Ollama (recomendado con Spark + Llama 3.1) ---
# URL del servidor Ollama en la Spark (puerto por defecto 11434; si usas export OLLAMA_HOST=0.0.0.0:11435, pon :11435)
OLLAMA_BASE_URL=http://172.31.17.20:11435
# Modelo instalado en Ollama (ej: llama3.1, llama3.1:8b)
OLLAMA_MODEL=llama3.1

# --- Gemini (alternativa en la nube) ---
# Solo necesario si AI_PROVIDER=gemini
# Obtén la API key en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Puerto del servidor IRIS (por defecto 3001)
PORT=3001
